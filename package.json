{
  "name": "mosaic-paint",
  "version": "2.5.0",
  "private": true,
  "description": "Vector editor for designing and coloring mosaics",
  "scripts": {
    "serve": "node tests/serve.js",
    "test": "npm run build && npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "bench": "node tests/perf/bench.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "check:slicer": "node --experimental-strip-types --no-warnings tests/slicer/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "tesseract.js": "^7.0.0"
  }
}
