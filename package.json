{
  "name": "mosaic-paint",
  "version": "1.0.0",
  "private": true,
  "description": "Vector editor for designing and coloring mosaics",
  "scripts": {
    "serve": "node tests/serve.js",
    "test": "npm run build && npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "bench": "node tests/perf/bench.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "check:slicer": "node --experimental-strip-types --no-warnings tests/slicer/check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild-wasm": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
